<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="alanchi.Examen.Views.ResumenPage"
             Title="ResumenPage">
    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="20">
            <Label x:Name="lblUsuario"/>
            <Label Text="RESUMEN" FontSize="22" HorizontalOptions="Fill" HorizontalTextAlignment="Center" />
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="8">
                <Label Text="Nombre"  Grid.Row="0" />
                <Label x:Name="lblNombre" Grid.Row="0" Grid.Column="1" />
                <Label Text="Apellido"  Grid.Row="1" />
                <Label x:Name="lblApellido" Grid.Row="1" Grid.Column="1" />
                <Label Text="Edad"  Grid.Row="2" />
                <Label x:Name="lblEdad" Grid.Row="2" Grid.Column="1" />
                <Label Text="Fecha de inicio"  Grid.Row="3" />
                <Label x:Name="lblFecha" Grid.Row="3" Grid.Column="1" />
                <Label Text="Plan"  Grid.Row="4" />
                <Label x:Name="lblPlan" Grid.Row="4" Grid.Column="1" />
                <Label Text="Casillero"  Grid.Row="5" />
                <Label x:Name="lblCasillero" Grid.Row="5" Grid.Column="1" />
                <Label Text="Monto Inicial"  Grid.Row="6" />
                <Label x:Name="lblMonto" Grid.Row="6" Grid.Column="1" />
                <Label Text="Pago mensual"  Grid.Row="7" />
                <Label x:Name="lblPago" Grid.Row="7" Grid.Column="1" />
                <Label Text="Pago Total"  Grid.Row="8" />
                <Label x:Name="lblTotal" Grid.Row="8" Grid.Column="1" />
            </Grid>
            <Button Text="Nuevo registro" x:Name="OnNuevo"  Clicked="OnNuevo_Clicked" />
            <Button Text="Cerrar sesión" x:Name="OnCerrar"  Clicked="OnCerrar_Clicked" />
            <Button Text="Guardar" x:Name="OnGuardar" Clicked="OnGuardar_Clicked"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>