<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="alanchi.Examen.Views.AcercaDePage"
             Title="AcercaDePage">
    <VerticalStackLayout Spacing="10" Padding="20">
        <Image Source="yo.jpg" HeightRequest="150" HorizontalOptions="Center" />
        <Label Text="Nombre: Anthony Lanchi" Style="{StaticResource EtiquetaGym}" />
        <Label Text="Carrera: Sistemas Informacion" Style="{StaticResource EtiquetaGym}" />
        <Label Text="Paralelo: A" Style="{StaticResource EtiquetaGym}" />
        <Button Text="Volver" x:Name="OnVolver" Style="{StaticResource BotonGym}" Clicked="OnVolver_Clicked" />
    </VerticalStackLayout>

</ContentPage>